<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:BankingThreads.UI.Presentation"
        xmlns:controls="using:BankingThreads.UI.Controls"
        x:Class="BankingThreads.UI.MainWindow"
        Title="Ledger"
        Width="1240" Height="900" MinWidth="1040" MinHeight="720"
        Background="#FFFFFF" WindowStartupLocation="CenterScreen">
    <Grid x:Name="WindowLayout" ColumnDefinitions="188,*">
        <Border x:Name="Sidebar" Background="#F3F3F5" BorderBrush="#E5E5E7" BorderThickness="0,0,1,0">
            <StackPanel Margin="12,16">
                <Button x:Name="OverviewNav" Classes="nav selected" Click="OnOverviewClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Width="16" Height="16" Classes="navigationIcon" Data="M 2,2 H 6 V 6 H 2 Z M 10,2 H 14 V 6 H 10 Z M 2,10 H 6 V 14 H 2 Z M 10,10 H 14 V 14 H 10 Z" />
                        <TextBlock Text="Overview" />
                    </StackPanel>
                </Button>
                <Button x:Name="HistoryNav" Classes="nav" Click="OnHistoryClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Width="16" Height="16" Classes="navigationIcon" Data="M 3,4 A 6,6 0 1 1 2,10 M 1,1 V 5 H 5 M 8,4 V 8 L 11,10" />
                        <TextBlock Text="History" />
                    </StackPanel>
                </Button>
                <Button x:Name="PriorityNav" Classes="nav" Click="OnPriorityClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Width="16" Height="16" Classes="navigationIcon" Data="M 2,14 V 10 H 4 V 14 Z M 7,14 V 6 H 9 V 14 Z M 12,14 V 2 H 14 V 14 Z" />
                        <TextBlock Text="Scheduling" />
                    </StackPanel>
                </Button>
                <Border Height="1" Background="#DDDDDF" Margin="10,12" />
                <Button x:Name="GuideNav" Classes="nav" Click="OnGuideClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Width="16" Height="16" Classes="navigationIcon" Data="M 3,1 H 13 V 15 H 3 Z M 5,5 H 11 M 5,8 H 11 M 5,11 H 9" />
                        <TextBlock Text="Notes" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="56,*">
            <Border Background="#FCFCFC" BorderBrush="#E8E8EA" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                    <Button x:Name="SidebarToggle" Classes="toolbar" Click="OnToggleSidebarClick"
                            ToolTip.Tip="Hide sidebar" AutomationProperties.Name="Hide sidebar" Padding="8">
                        <Path Width="18" Height="16" Stroke="#636366" StrokeThickness="1.3"
                              Data="M 2,1 H 16 Q 17,1 17,2 V 14 Q 17,15 16,15 H 2 Q 1,15 1,14 V 2 Q 1,1 2,1 Z M 6,1 V 15 M 3,5 H 4 M 3,8 H 4 M 3,11 H 4" />
                    </Button>
                    <TextBlock Grid.Column="1" x:Name="BreadcrumbText" Text="Overview" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="NoticeText" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                        <Button x:Name="ExportButton" Classes="toolbar" Click="OnExportClick"
                                IsEnabled="False" Padding="10,7" FontSize="12" Content="Export CSV"
                                ToolTip.Tip="Save this session's results and events" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="28,24">
                    <StackPanel x:Name="OverviewPage" Spacing="24">
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Background="#EEEEF0" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="UnsynchronizedButton" Classes="segment" Content="Unsynchronized" Click="OnUnsynchronizedClick" />
                                    <Button x:Name="SynchronizedButton" Classes="segment selected" Content="Synchronized" Click="OnSynchronizedClick" />
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="RepeatButton" Classes="secondary" Content="Run 5 trials" Click="OnRepeatClick" FontSize="12" />
                                <Button x:Name="RunButton" Classes="primary" Click="OnRunClick" MinWidth="78">
                                    <TextBlock x:Name="RunButtonText" Text="Run" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Padding="0,8,0,20" BorderBrush="#E8E8EA" BorderThickness="0,0,0,1">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="BalanceCaption" Text="Balance" Classes="muted" FontSize="12" />
                                    <TextBlock Grid.Column="1" x:Name="RunSummaryText" Classes="muted" FontSize="11" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="0.8*,1.2*" ColumnSpacing="24">
                                    <StackPanel Spacing="18" VerticalAlignment="Center">
                                        <TextBlock x:Name="BalanceText" Text="$2,000.00" FontSize="40" FontWeight="Normal" LetterSpacing="-1" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="5" Height="5" Fill="#007AFF" />
                                                <TextBlock Text="Observed" FontSize="11" Classes="muted" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Rectangle Width="9" Height="1" Fill="#B7BDCA" />
                                                <TextBlock Text="Reference" FontSize="11" Classes="muted" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <controls:BalanceChart Grid.Column="1" x:Name="Chart" Height="148"
                                                           AutomationProperties.Name="Balance at worker completion"
                                                           ToolTip.Tip="Reported balances when workers finish" />
                                </Grid>
                                <Border Grid.Row="2" BorderBrush="#E8E8EA" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                    <Grid ColumnDefinitions="*,*,*,*">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Starting" Classes="muted" FontSize="11" />
                                            <TextBlock x:Name="InitialBalanceText" Text="$2,000.00" FontSize="14" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Reference" Classes="muted" FontSize="11"
                                                       ToolTip.Tip="Fixed-order calculation. Rounding can vary with another valid order." />
                                            <TextBlock x:Name="ReferenceText" Text="—" FontSize="14" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="6">
                                            <TextBlock Text="Difference" Classes="muted" FontSize="11" />
                                            <TextBlock x:Name="DifferenceText" Text="—" FontSize="14" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="6">
                                            <TextBlock Text="Duration" Classes="muted" FontSize="11"
                                                       ToolTip.Tip="Worker runtime, excluding the reference calculation" />
                                            <TextBlock x:Name="DurationText" Text="—" FontSize="14" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Spacing="10">
                            <TextBlock Text="Workers" Classes="section" />
                            <Border Background="#F7F7F8" CornerRadius="10" Padding="6,14">
                            <ItemsControl x:Name="WorkerItems">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:WorkerModel">
                                        <Border Padding="12,0" ToolTip.Tip="{Binding Rate}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </Border>
                        </StackPanel>

                        <Border Classes="card" ClipToBounds="True">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <TextBlock Text="Activity" Classes="section" Margin="18,14" />
                                <Border Grid.Row="1" Background="#F7F7F8" BorderBrush="#E8E8EA" BorderThickness="0,1" Padding="18,9">
                                    <Grid ColumnDefinitions="70,145,*,100">
                                        <TextBlock Text="Time" Classes="muted" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="Worker" Classes="muted" FontSize="11" />
                                        <TextBlock Grid.Column="2" Text="Event" Classes="muted" FontSize="11" />
                                        <TextBlock Grid.Column="3" Text="Balance" Classes="muted" FontSize="11" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="2" Height="230">
                                    <TextBlock x:Name="EmptyActivity" Text="No activity" Classes="muted" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <ScrollViewer x:Name="ActivityScroll" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ActivityItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:EventModel">
                                                    <Border BorderBrush="#EEEEF0" BorderThickness="0,0,0,1" Padding="18,10">
                                                        <Grid ColumnDefinitions="70,145,*,100">
                                                            <TextBlock Text="{Binding Time}" FontSize="11" Classes="muted" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Worker}" FontSize="11" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Balance}" FontSize="11" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="StatusText" IsVisible="False" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="HistoryPage" IsVisible="False" Spacing="16">
                        <Border Classes="card" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock x:Name="SessionSummary" Text="No runs" Classes="muted" FontSize="12" />
                                <StackPanel x:Name="EmptyHistory" Spacing="14" Margin="0,36" HorizontalAlignment="Center">
                                    <TextBlock Text="No runs yet" Classes="muted" FontSize="13" HorizontalAlignment="Center" />
                                    <Button Classes="secondary" Content="Go to overview" Click="OnOverviewClick" />
                                </StackPanel>
                                <Grid ColumnDefinitions="40,*,120,110,80,55" ColumnSpacing="8">
                                    <TextBlock Text="Run" Classes="muted" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="Mode" Classes="muted" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="Balance" Classes="muted" FontSize="11" />
                                    <TextBlock Grid.Column="3" Text="Difference" Classes="muted" FontSize="11" />
                                    <TextBlock Grid.Column="4" Text="Duration" Classes="muted" FontSize="11" />
                                </Grid>
                                <ItemsControl x:Name="HistoryItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:RunRecord">
                                            <Border BorderBrush="#E8E8EA" BorderThickness="0,0,0,1" Padding="0,14">
                                                <Grid ColumnDefinitions="40,*,120,110,80,55" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding NumberLabel}" Classes="muted" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="5">
                                                        <TextBlock Text="{Binding Mode}" FontSize="12" />
                                                        <TextBlock Text="{Binding Time}" Classes="muted" FontSize="11" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Balance}" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Difference}" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Duration}" FontSize="11" Classes="muted" VerticalAlignment="Center" />
                                                    <Button Grid.Column="5" Classes="link" Content="View" Click="OnViewRunClick" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Export to keep this session." Classes="muted" FontSize="11" />
                    </StackPanel>

                    <StackPanel x:Name="PriorityPage" IsVisible="False">
                        <Border Classes="card" Padding="24">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Priority test" Classes="section" />
                                <TextBlock Text="Not implemented." Classes="muted" FontSize="13" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="GuidePage" IsVisible="False">
                        <Border Classes="card" Padding="24">
                            <StackPanel Spacing="22">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Synchronization" Classes="section" />
                                    <TextBlock Text="The lock protects all four updates in each worker. It does not enforce order."
                                               TextWrapping="Wrap" Classes="muted" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Reference" Classes="section" />
                                    <TextBlock Text="A fixed-order result. Rounding can produce small differences in other valid orders."
                                               TextWrapping="Wrap" Classes="muted" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Chart" Classes="section" />
                                    <TextBlock Text="Balances reported when workers finish, not every transaction. Logging can affect scheduling."
                                               TextWrapping="Wrap" Classes="muted" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Timing" Classes="section" />
                                    <TextBlock Text="Worker runtime, excluding the reference calculation." Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Environment" Classes="section" />
                                    <TextBlock x:Name="PlatformText" Classes="muted" />
                                    <TextBlock Text="Use Windows for the final demonstration." Classes="muted" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
